# Шаблон для .env. Этот файл МОЖНО коммитить: в нём нет значений.
# Скопируйте его в .env и заполните то, что понадобится.

# Личный токен Figma (нужен только если работать с API Figma напрямую)
FIGMA_ACCESS_TOKEN=
# Токен GitHub (нужен только для работы с API GitHub без входа через gh)
GITHUB_TOKEN=
